generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Customer {
  id               String    @id @default(uuid())
  name             String
  phone            String
  defaultAddress   String
  defaultLat       Float
  defaultLng       Float
  priceListId      String?
  creditBalance    Float     @default(0)
  tier             String?
  isMember         Boolean   @default(false)
  memberId         String?   @unique
  isVIP            Boolean   @default(false)
  isCorporate      Boolean   @default(false)
  isWhatsapp       Boolean   @default(false)
  email            String?
  lineId           String?
  language         String?
  remark           String?
  secondaryAddress String?
  dob              String?
  taxId            String?
  companyName      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  memberExpiryDate DateTime?
  memberStartDate  DateTime?
  jobs             Job[]
}

model Job {
  id                     String        @id @default(uuid())
  type                   String
  customerId             String?
  customerName           String?
  customerPhone          String?
  pickupLocation         String
  dropoffLocation        String
  pickupLat              Float
  pickupLng              Float
  dropoffLat             Float
  dropoffLng             Float
  distance               Float
  fee                    Float
  status                 String
  subStatus              String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @default(now()) @updatedAt
  scheduledAt            DateTime
  completedAt            DateTime?
  proofImageUrl          String?
  pickupProofImageUrl    String?
  deliveryProofImageUrl  String?
  riderId                String?
  bagImageUrl            String?
  billImageUrl           String?
  serviceType            String?
  laundryTypes           String?
  source                 String?
  totalAmount            Float?
  paymentMethod          String?
  paymentChannel         String?
  isPaid                 Boolean       @default(false)
  discount               Float?        @default(0)
  pickupDistance         Float?
  deliveryDistance       Float?
  pickupCommission       Float?
  deliveryCommission     Float?
  pickupScheduledAt      DateTime?
  pickupScheduledEndAt   DateTime?
  deliveryScheduledAt    DateTime?
  deliveryScheduledEndAt DateTime?
  pickupRiderId          String?
  deliveryRiderId        String?
  itemsJson              String?
  legsJson               String?
  remark                 String?
  adminNotesJson         String?
  branchId               String?
  createdBy              String?
  cashPlaced             Boolean       @default(false)
  isStuck                Boolean       @default(false)
  shiftId                String?
  walletBalanceAfter     Float?
  discountPercent        Float?        @default(0)
  branch                 ShopLocation? @relation(fields: [branchId], references: [id])
  customer               Customer?     @relation(fields: [customerId], references: [id])
  shift                  CashierShift? @relation(fields: [shiftId], references: [id])
}

model ServiceItem {
  id          String  @id @default(uuid())
  name        String
  price       Float
  memberPrice Float
  category    String
  unit        String?
  nameEn      String?
}

model Rider {
  id                String             @id @default(uuid())
  name              String
  nickname          String?
  phone             String
  status            String
  currentLat        Float?
  currentLng        Float?
  avatarUrl         String?
  rating            Float              @default(5.0)
  completedJobs     Int                @default(0)
  commissionBalance Float              @default(0)
  nationalId        String?
  vehicleType       String?
  vehiclePlate      String?
  branchId          String?
  color             String?            @default("#3b82f6")
  branch            ShopLocation?      @relation(fields: [branchId], references: [id])
  transactions      RiderTransaction[]
}

model RiderTransaction {
  id        String   @id @default(uuid())
  riderId   String
  jobId     String?
  amount    Float
  type      String
  detail    String?
  createdAt DateTime @default(now())
  rider     Rider    @relation(fields: [riderId], references: [id])
}

model PriceList {
  id            String  @id @default(uuid())
  name          String
  isDefault     Boolean @default(false)
  servicePrices String
}

model ShopLocation {
  id           String         @id @default(uuid())
  name         String
  address      String
  lat          Float
  lng          Float
  noCommission Boolean        @default(false)
  area         String         @default("BKK")
  logoUrl      String?
  phone        String?
  taxId        String?
  staff        AdminUser[]
  shifts       CashierShift[]
  jobs         Job[]
  riders       Rider[]
}

model POI {
  id            String  @id @default(uuid())
  name          String
  address       String
  lat           Float
  lng           Float
  placeId       String?
  closestShopId String?
  distanceKm    Float?
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model ActivityLog {
  id         String   @id @default(uuid())
  entityId   String
  entityType String
  action     String
  details    String?
  userId     String?
  userName   String?
  createdAt  DateTime @default(now())
}

model AdminUser {
  id          String        @id @default(uuid())
  email       String        @unique
  password    String
  name        String
  role        String        @default("staff")
  permissions String
  area        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  branchId    String?
  branch      ShopLocation? @relation(fields: [branchId], references: [id])
}

model CashierShift {
  id              String       @id @default(uuid())
  branchId        String
  userId          String
  userName        String
  openedAt        DateTime     @default(now())
  closedAt        DateTime?
  startingCash    Float
  expectedCash    Float        @default(0)
  actualCash      Float?
  cashSales       Float        @default(0)
  transferSales   Float        @default(0)
  cardSales       Float        @default(0)
  creditSales     Float        @default(0)
  shortageOverage Float?
  status          String       @default("open")
  notes           String?
  cardOrders      Int          @default(0)
  cashOrders      Int          @default(0)
  creditOrders    Int          @default(0)
  totalOrders     Int          @default(0)
  transferOrders  Int          @default(0)
  branch          ShopLocation @relation(fields: [branchId], references: [id])
  jobs            Job[]
}
